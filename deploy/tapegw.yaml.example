# Пример конфигурации tapegw.
#
# Любое поле переопределяется переменной TAPEGW_<ПУТЬ_В_ YAML В ВЕРХНЕМ РЕГИСТРЕ>:
#   s3.region                    -> TAPEGW_S3_REGION
#   migrator.batch_max_bytes     -> TAPEGW_MIGRATOR_BATCH_MAX_BYTES
#   db.migrate_on_start          -> TAPEGW_DB_MIGRATE_ON_START
#
# Числа ниже — стартовые значения для настройки на стенде, не требования.
# Источник истины по смыслу каждого поля — docs/ARCHITECTURE.md.

s3:
  listen:
    - ":7070"
  region: us-east-1
  tls:
    cert: ""          # пусто = HTTP. Для продакшена обязателен: SigV4 в открытом виде
    key: ""
  # Файловые учётки совместимы с Postgres-IAM только как альтернатива:
  # kek_file теперь обязателен (шифрование тела, ADR-0014), а вместе два
  # источника учёток быть не может. Поэтому iam_dir закомментирован, а не пуст.
  # iam_dir: /etc/tapegw/iam
  # Класс хранилища не настраивается: tapegw хранит всё на ленте и всегда
  # отвечает GLACIER (ADR-0003). Отдельной настройки в конфиге нет намеренно.
  health_path: /health
  max_connections: 50000
  max_requests: 50000
  multipart_max_parts: 10000
  # Верхняя граница размера объекта: крупнее приходит EntityTooLarge. Обязана быть
  # не больше migrator.batch_max_bytes — иначе объект никогда не влезет в батч,
  # а батч пишется целиком на один носитель (ADR-0008). Проверка выполняется
  # при старте.
  max_object_size: 100GiB

# Ключи root-аккаунта. В продакшене задавайте не файлом, а переменной окружения
# в systemd-юните (TAPEGW_ROOT_ACCESS / TAPEGW_ROOT_SECRET), чтобы секреты
# не попали в git и в бэкап /etc.
root:
  access: ""
  secret: ""

db:
  # search_path обязателен: схема tapegw создаётся миграциями автоматически.
  dsn: postgres://tapegw@localhost/phobos?search_path=tapegw
  max_conns: 20
  connect_timeout: 10s
  migrate_on_start: true
  advisory_lock_timeout: 30s       # ожидание pg_advisory_xact_lock на ключе (ADR-0005)

# Учётки versitygw (ADR-0009). kek_file переключает шлюз на учётки из таблицы
# accounts; оба источника сразу запрещены — ошибка запуска.
iam:
  # Файл с кольцом KEK: {"1": "<base64 на 32 байта>", "2": "..."}, права 0400.
  # KEK обязан быть вне БД: вместе с обёртками секретов он обесценивает и то,
  # и другое. Старые версии не удаляйте, пока на них ссылается хоть одна
  # строка accounts — иначе эти учётки перестанут входить (ADR-0014).
  # Обязателен с T2: шифрование тела объекта включено всегда (ADR-0014),
  # и без кольца KEK нечем завернуть ключ тенанта. Раньше поле только включало
  # Postgres-IAM и могло быть пустым.
  kek_file: /etc/tapegw/kek.json
  # Версия KEK для новых обёрток. Ротация — это три шага, а не один:
  #   1. добавить новую версию в kek_file;
  #   2. поднять номер здесь и выполнить tapegw-keyctl -cmd rotate-kek;
  #   3. старую версию из файла НЕ удалять, пока tapegw-keyctl -cmd forget-kek
  #      не разрешит: на неё ссылаются экспорты и дампы до ротации.
  kek_version: 1
  # Срок, в который обёрнутые TEK переживают удаление тенанта (ADR-0014).
  # Именно это число называется в договоре как «данные станут недоступны
  # необратимо через N».
  export_retention: 720h
  # Глубина PITR-бэкапов Postgres и WAL-архива. Обязана быть правдой:
  # tenants.wrapped_key лежит в каждом дампе, поэтому реальная окончательность
  # равна максимуму из двух сроков. Больше export_retention — ошибка запуска.
  backup_retention: 0s  # 0s = PITR нет; если бэкапы есть — укажите срок

spool:
  landing: /srv/tapegw/landing     # mpu/ лежит здесь же, на той же XFS с reflink=1
  cache: /srv/tapegw/cache         # отдельный том; cache/tmp обязан быть на той же ФС
  landing_watermark: {high: 80, low: 60}
  cache_watermark: {high: 85, low: 70}
  mpu_ttl: 168h
  orphan_grace: 24h
  slowdown_headroom: 5             # на сколько % выше high ещё принимаем PUT (только запись!)
  evict_retries: 2                 # сколько раз GET перечитает состояние при ENOENT (ADR-0004)
  landing_min_retention: 24h       # минимальный срок доступности дисковой копии;
                                   # она же expiry-date в x-amz-restore (ADR-0003)

phobos:
  family: tape                     # dir — для CI и разработки без лент
  layout: raid1
  layout_params: {repl_count: "1"}
  tags: []
  max_inflight: 1                  # до подтверждения потокобезопасности libphobos (спайк M0-3)

migrator:
  batch_max_objects: 1000
  batch_max_bytes: 200GiB
  batch_max_wait: 15m              # это же RPO: всё, что не ушло на ленту, живёт только на диске
  max_attempts: 10

recaller:
  batch_max_objects: 500
  batch_max_bytes: 0               # 0 = не ограничивать по байтам
  batch_max_wait: 5m
  max_attempts: 10

metrics:
  listen: ":9464"                  # свой Prometheus-экспортёр, см. ADR-0002

admin:
  listen: ""                       # пусто = админ-API на S3-порту под path_prefix
  path_prefix: /admin

logging:
  level: info                      # debug | info | warn | error
  format: json                     # json | text
