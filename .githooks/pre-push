#!/usr/bin/env bash
# Не пускать в удалённую ветку красное.
#
# Коммит с красной проверкой сам по себе безвреден — это рабочая запись. Дорого
# другое: красное в удалённой ветке, где его увидит ревьюер, и красный прогон CI,
# которого можно было не тратить. Хук стоит ровно на этой границе.
#
# Почему не `make commit`: он обходится обычным `git commit`, а проверка,
# которую можно обойти по невнимательности, не проверка.
#
# Включается один раз: make hooks (git config core.hooksPath .githooks).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: make check"
if ! make check; then
	cat >&2 <<'MSG'

pre-push: проверка красная — ветка не отправлена.

Если падение не связано с вашими правками (например, упал пакет, которого вы не
касались), разберитесь и напишите об этом в описании PR, а не пушайте в обход
хука: обход (--no-verify) оставляет красный CI без объяснения.
MSG
	exit 1
fi
echo "pre-push: проверка зелёная, отправляем"
