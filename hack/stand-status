#!/usr/bin/env bash
# Проверка стенда Phobos: смотрит и ничего не меняет.
#
# Нужен потому, что стенд три захода подряд подводил одним и тем же: процесс
# запущен вручную, systemd про него не знает, и «активный юнит» соседствует с
# мёртвыми локами в DRS/DSS. Проверка должна быть командой, а не памятью
# человека.
#
# Выходит с ненулевым кодом на любое расхождение и печатает, что именно не так.
set -uo pipefail


# --- 0. какая версия скрипта выполняется ------------------------------------
# Скрипты копируют на ВМ и правят на месте. Прогнать старую копию и прочитать её
# вывод как проверку — тот же класс ошибки, что «проверяли не тот объект»: на ВМ
# уже прогоняли старый stand-status и делали вывод про проверку, которой нет.
# Первая строка вывода обязана отвечать на вопрос «что сейчас исполнилось».
root=$(cd "$(dirname "$0")/.." && pwd)
if git -C "$root" rev-parse --short HEAD >/dev/null 2>&1; then
    ver=$(git -C "$root" rev-parse --short HEAD)
    [ -n "$(git -C "$root" status --porcelain -- hack)" ] && ver="$ver-dirty"
elif [ -f "$(dirname "$0")/VERSION" ]; then
    # Копия вне git, но скопирована стендовой целью: она знает, из какого
    # коммита её взяли.
    ver="копия из $(cat "$(dirname "$0")/VERSION")"
else
    ver="вне git и без VERSION; mtime $(date -r "$0" +%Y-%m-%dT%H:%M:%S)"
fi
echo "### stand-status @ $ver ($root)"

# --banner: напечатать только версию и выйти. Нужен тесту в make check: он
# проверяет, что баннер в скрипте есть, не трогая стенд. Без такого флага
# «правка не применилась» обнаруживается только глазами — так и прошло, что
# stand-up баннера не получил.
if [ "${1:-}" = "--banner" ]; then
    exit 0
fi
rc=0
fail() { echo "FAIL: $*"; rc=1; }
ok()   { echo "ok:   $*"; }

# Файл конфига Phobos. Переменная PHOBOS_CONF нужна тесту на закрытость DSS-
# проверок: он подсовывает конфиг с недостижимым DSN. Заодно единственное
# место, где путь к конфигу назван — раньше порт и DSN читались из хардкода.
phobos_conf=${PHOBOS_CONF:-/etc/phobos.conf}

# Файл для stderr psql. 2>&1 в переменную результата смешивает предупреждения
# с данными: «WARNING ...» попало бы в список устройств и стало бы ложным
# «устройство в failed: WARNING ...». stderr смотрим только при ненулевом коде.
psql_err=$(mktemp) || { echo "FAIL: не создал временный файл для stderr psql"; exit 1; }
trap 'rm -f "$psql_err"' EXIT

# --- 1. процессы Phobos и их принадлежность systemd -------------------------
found_proc=0
for pid in $(pgrep -x phobosd; pgrep -x phobos_tlc); do
    found_proc=1
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    cg=$(cut -d: -f3 "/proc/$pid/cgroup" 2>/dev/null)
    case "$cg" in
        */phobosd.service|*/phobos_tlc.service)
            ok "pid $pid под systemd ($cg)" ;;
        *)
            fail "pid $pid запущен вручную (cgroup: ${cg:-нет}): $cmd — systemd его не остановит" ;;
    esac
done
[ "$found_proc" = 1 ] || fail "ни одного процесса Phobos не запущено"

# --- 2. юниты ---------------------------------------------------------------
for u in phobos_tlc phobosd; do
    if systemctl is-active --quiet "$u"; then
        ok "юнит $u активен"
    else
        fail "юнит $u не активен ($(systemctl is-active "$u" 2>&1))"
    fi
done

# --- 3. сокет LRS и порт TLC ------------------------------------------------
if ss -xlp 2>/dev/null | grep -q 'socklrs'; then
    ok "сокет LRS слушается"
else
    fail "сокет LRS не слушается: put даст 'Transport endpoint is not connected'"
fi

port=$(sed -n 's/^[[:space:]]*port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$phobos_conf" | head -1)
port=${port:-20123}
if ss -ltn "sport = :$port" 2>/dev/null | grep -q ":$port"; then
    ok "TLC слушает порт $port"
else
    fail "TLC не слушает порт $port — phobosd не сможет работать с библиотекой"
fi

# --- 4. устройства в состоянии failed ---------------------------------------
# Устройства и носители — разные объекты. `phobos dir list -o all` показывает
# строку НОСИТЕЛЯ: её adm_status может быть unlocked, а устройство тем временем
# в failed — LRS такое устройство при распределении записи не рассматривает, и
# снаружи это выглядит как «всё зелёное, но ENODEV». Состояние устройства видно
# только в DSS. Только чтение, ничего не меняем.
# Проверки DSS закрыты при сбое (шаг 0 плана среза): если psql не ответил,
# мы о состоянии устройств ничего не знаем, а «ok» здесь — зелёный, который
# ничего не проверил. Неверный DSN обязан давать красный, а не «упущено».
dsn=$(sed -n 's/^[[:space:]]*connect_string[[:space:]]*=[[:space:]]*\(.*\)/\1/p' "$phobos_conf" | head -1)
if [ -n "$dsn" ]; then
    # -w: без него psql при DSN с password-required молча встанет на запрос
    # пароля — проверка не «красная», а висящая.
    if bad=$(psql -w "$dsn" -At -c "SELECT family || ' ' || id FROM device WHERE adm_status = 'failed'" 2>"$psql_err"); then
        if [ -n "$bad" ]; then
            while IFS= read -r d; do
                fail "устройство в failed: $d — LRS его не рассматривает; снять: phobos <family> unlock (или drive unlock) + рестарт"
            done <<< "$bad"
        else
            ok "ни одного устройства в failed"
        fi
    else
        fail "DSS недоступен, состояние устройств не проверено: $(head -1 "$psql_err")"
    fi
else
    fail "не удалось прочитать dss.connect_string из $phobos_conf — состояние устройств не проверено"
fi

# --- 4b. есть ли в библиотеке куда писать -----------------------------------
# Снятый флаг записи снаружи неотличим от «нет места»: put даёт ENOSPC. Флаг
# снимают руками (phobos tape set-access -- -P) и забывают — например в спайке
# про поколения лент. Булевы значения в вывод переводим словами: 't'/'f' в
# столбце put читается и как «разрешено», и как «закрыто», и обе ошибки
# выглядели уверенными.
if [ -n "$dsn" ]; then
    if nowrite=$(psql -w "$dsn" -At -c "SELECT library FROM media WHERE family = 'tape' GROUP BY library HAVING NOT bool_or(put AND adm_status = 'unlocked')" 2>"$psql_err"); then
        if [ -n "$nowrite" ]; then
            while IFS= read -r lib; do
                fail "запись в библиотеку $lib невозможна: нет ни одной разблокированной ленты с разрешённой записью (put)"
            done <<< "$nowrite"
        else
            ok "в каждой ленточной библиотеке есть лента, доступная для записи"
        fi
    else
        fail "DSS недоступен, возможность записи не проверена: $(head -1 "$psql_err")"
    fi
else
    fail "connect_string не прочитан — возможность записи не проверена"
fi

# --- 5. локи с мёртвыми владельцами -----------------------------------------
# Локи живут в DSS, а не в памяти процесса: убить phobosd недостаточно.
for kind in dir drive; do
    out=$(phobos "$kind" list -o all 2>/dev/null)
    [ -n "$out" ] || continue
    for owner in $(printf '%s\n' "$out" | tr '|' '\n' | grep -E '^[[:space:]]*[0-9]{3,}[[:space:]]*$' | tr -d ' '); do
        if [ ! -d "/proc/$owner" ]; then
            fail "$kind: лок принадлежит pid $owner, которого больше нет — нужен phobos lock clean при остановленных демонах"
        fi
    done
done

if [ "$rc" = 0 ]; then
    echo "стенд в порядке"
else
    echo "стенд не в порядке: см. FAIL выше; полный перезапуск — hack/stand-up"
fi
exit "$rc"
